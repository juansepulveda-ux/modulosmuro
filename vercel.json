{
  "rewrites": [
    { "source": "/planificador", "destination": "/planificador.html" }
  ],
  "headers": [
    {
      "source": "/planificador.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "functions": {
    "api/publicar.js": {
      "maxDuration": 10
    }
  }
}
