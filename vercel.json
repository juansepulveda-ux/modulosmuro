{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/planificador",
      "destination": "/planificador.html"
    },
    {
      "source": "/planificador-muro",
      "destination": "/planificador_muro.html"
    },
    {
      "source": "/planificador-airtrail",
      "destination": "/planificador_airtrail.html"
    }
  ],
  "headers": [
    {
      "source": "/planificador(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}