{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/planificador",
      "destination": "/planificador.html"
    },
    {
      "source": "/planificador-muro",
      "destination": "/planificador_muro.html"
    },
    {
      "source": "/planificador-airtrail",
      "destination": "/planificador_airtrail.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/inscripciones",
      "destination": "/inscripciones.html"
    },
    {
      "source": "/checkin",
      "destination": "/checkin.html"
    },
    {
      "source": "/pantalla",
      "destination": "/pantalla.html"
    },
    {
      "source": "/hoy",
      "destination": "/hoy.html"
    },
    {
      "source": "/declaracion",
      "destination": "/declaracion.html"
    },
    {
      "source": "/elegir-modulos",
      "destination": "/elegir-modulos.html"
    },
    {
      "source": "/declaracion-registro",
      "destination": "/declaracion-registro.html"
    }
  ],
  "headers": [
    {
      "source": "/planificador(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/login(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/inscripciones(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/checkin(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/pantalla(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/hoy(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/declaracion(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/elegir-modulos(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/declaracion-registro(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
